// Windows version resource for imview.exe. Configured by CMakeLists.txt so the
// version lives in one place (project(... VERSION ...)).
//
// No icon on purpose: the project has not picked one yet.

#include <windows.h>

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 FILEFLAGSMASK  0x3fL
#ifdef _DEBUG
 FILEFLAGS      0x1L
#else
 FILEFLAGS      0x0L
#endif
 FILEOS         0x40004L
 FILETYPE       0x1L
 FILESUBTYPE    0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription",  "ImView image comparison viewer"
            VALUE "FileVersion",      "@PROJECT_VERSION@"
            VALUE "InternalName",     "imview"
            VALUE "OriginalFilename", "imview.exe"
            VALUE "ProductName",      "ImView"
            VALUE "ProductVersion",   "@PROJECT_VERSION@"
            VALUE "Comments",         "Preview build"
            VALUE "LegalCopyright",   "Public domain (Unlicense)"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
